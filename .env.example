# Which provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model id for the chosen provider (optional; sensible defaults per provider)
# LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Hard cap on tool-call turns per generation (runaway guard)
MAX_TOOL_TURNS=10

# Web search backend for Topic Sources: tavily | brave | duckduckgo (keyless fallback)
WEB_SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Where the SQLite file, document store, and git clone cache live
# DATA_DIR=./data

# Any OpenAI-compatible endpoint (Ollama, LM Studio, a gateway). Leave unset for OpenAI itself.
# OPENAI_BASE_URL=http://localhost:11434/v1
